# Copy this file to `.env` on each machine (local + VPS).
# `.env` is gitignored — never commit real credentials.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL — local example (empty password). On VPS fill the real user/password/host.
DATABASE_URL="mysql://root@127.0.0.1:3306/turkey"

# Auth (email OTP — 4 digits) for storefront customers
AUTH_SECRET="change-me-on-vps"
# Initial super admin (password login on /admin). Used only if that user has no password yet.
SUPER_ADMIN_EMAIL="a_fattah_m@icloud.com"
SUPER_ADMIN_PASSWORD="Admin@123"

# SMTP — fill these (local + VPS). Never commit real password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO_EMAIL=

# PayTR — set on the server only, never in git or chat.
# Local/sandbox: PAYTR_TEST_MODE=1. Production: 0 and live merchant keys.
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# PAYTR_TEST_MODE=1

# Production: NEXT_PUBLIC_SITE_URL=https://turateksyagmurluk.com
# Search Console token is not an env var — paste it in /admin/ayarlar.
