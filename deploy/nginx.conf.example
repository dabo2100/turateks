# Owner: copy to /etc/nginx/sites-available/turateksyagmurluk.com
# Then: ln -s .../sites-available/turateksyagmurluk.com .../sites-enabled/
# Certbot: sudo certbot --nginx -d turateksyagmurluk.com -d www.turateksyagmurluk.com
#
# Agents do not SSH. Owner applies this on the VPS.

upstream turateks_next {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name turateksyagmurluk.com www.turateksyagmurluk.com;
    return 301 https://turateksyagmurluk.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.turateksyagmurluk.com;
    # ssl_certificate /etc/letsencrypt/live/turateksyagmurluk.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/turateksyagmurluk.com/privkey.pem;
    return 301 https://turateksyagmurluk.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name turateksyagmurluk.com;

    # ssl_certificate /etc/letsencrypt/live/turateksyagmurluk.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/turateksyagmurluk.com/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 20m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/paytr/callback {
        proxy_pass http://turateks_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://turateks_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
